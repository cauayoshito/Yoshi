# Conexão com o Postgres (Supabase → Connect → Transaction pooler → URI)
# Local: postgresql://postgres:postgres@127.0.0.1:5432/yoshibet
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Segredo usado para assinar os tokens JWT — TROQUE em produção!
JWT_SECRET=troque-este-segredo-em-producao

# Porta do servidor HTTP (plataformas geralmente injetam)
PORT=3000

# E-mail que vira administrador ao se cadastrar
ADMIN_EMAIL=admin@yoshibet.com

# Protege a rota /api/cron/settle (Vercel Cron envia como Bearer token)
CRON_SECRET=

# Chave PIX exibida nas cobranças (demo)
PIX_KEY=pagamentos@yoshibet.com.br
PIX_MERCHANT_NAME=YOSHI BET
PIX_MERCHANT_CITY=SAO PAULO

# Bônus de primeiro depósito: percentual e teto em centavos
FIRST_DEPOSIT_BONUS_PCT=100
FIRST_DEPOSIT_BONUS_CAP_CENTS=50000

# Demo: tempo (ms) até a cobrança PIX ser confirmada automaticamente.
# Em produção, remova — a confirmação vem do webhook do PSP.
PIX_DEMO_AUTOCONFIRM_MS=4000
